# Backend (copy to backend/.env)
# Requires the pgvector extension: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_law

# Used to sign JWTs and to encrypt provider API keys stored in the DB.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
EMBEDDING_DIM=768

# NOTE: LLM, embedding and eCourts credentials are configured in the
# Settings page (stored encrypted in the DB), not in environment variables.

# Frontend (frontend/.env)
# VITE_API_URL=http://localhost:8000
